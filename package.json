{
    "name": "datatables.net-scroller-bm",
    "description": "Scroller for DataTables with styling for [Bulma](https://bulma.io/)",
    "main": "./js/scroller.bulma.js",
    "module": "./js/scroller.bulma.mjs",
    "style": "./css/scroller.bulma.css",
    "types": "./types/scroller.bulma.d.ts",
    "version": "3.0.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Scroller",
        "Virtual Scrolling",
        "Bulma",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-scroller": "3.0.0",
        "datatables.net-bm": "^3"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/Scroller.git"
    },
    "exports": {
        ".": {
            "types": "./types/scroller.bulma.d.ts",
            "import": "./js/scroller.bulma.mjs",
            "default": "./js/scroller.bulma.mjs",
            "require": "./js/scroller.bulma.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/scroller.bulma.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}